# LLM 配置 - 复制为 .env 后填入你的 API Key
# 支持的 Provider: openai, deepseek, qwen, moonshot, mock

LLM_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=  # 可选：自定义代理地址（如 https://api.openai.com/v1）

# DeepSeek 配置（如使用 DeepSeek 请取消注释）
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Qwen (通义千问) 配置
# QWEN_API_KEY=your-qwen-api-key-here
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Moonshot (月之暗面) 配置
# MOONSHOT_API_KEY=your-moonshot-api-key-here
# MOONSHOT_MODEL=moonshot-v1-8k
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 通用覆盖（可选）
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
